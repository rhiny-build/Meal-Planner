// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")          // pooled — used by the app at runtime
  directUrl = env("DATABASE_URL_UNPOOLED") // direct — used by Prisma CLI (migrations)
}

// Recipe model stores all recipe information
model Recipe {
  id                 String   @id @default(cuid())
  name               String
  ingredients        String   // Stored as text, one ingredient per line (kept for backwards compatibility)
  proteinType        String?  // chicken, fish, red-meat, vegetarian
  carbType           String?  // rice, pasta, couscous, fries, other
  vegetableType      String?
  recipeUrl          String?  // link to URL if exists
  prepTime           String?  // quick, medium, long
  tier               String   // favorite, non-regular, new
  isLunchAppropriate Boolean  @default(false) // Whether this recipe is suitable for lunch
  kind               String   @default("full") // full | quick (quick = quick side/main such as Simple Fries)
  servings           Int?     // How many people the ingredient amounts serve (for scaling)
  description        String?  // Short blurb shown in the recipe book / cook mode
  totalTimeMinutes   Int?     // Start-to-table time; prepTime (quick/medium/long) stays as the coarse bucket
  notes              String?  // Free-form recipe notes (tips, variations)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relationship: A recipe can appear in multiple meal plans
  proteinMealPlans   MealPlan[] @relation("ProteinRecipe")
  carbMealPlans      MealPlan[] @relation("CarbRecipe")
  vegetableMealPlans MealPlan[] @relation("VegetableRecipe")
  lunchMealPlans     MealPlan[] @relation("LunchRecipe")

  // Relationship: A recipe has many structured ingredients
  structuredIngredients Ingredient[]

  // Relationship: A recipe has an optional method (zero steps is normal)
  steps RecipeStep[]
}

// RecipeStep stores one step of a recipe's method. Method is optional: a recipe may have no steps.
// Step text may reference ingredients with {ing:<ingredientId>} tokens (see lib/recipeStepTokens.ts).
model RecipeStep {
  id           String   @id @default(cuid())
  recipeId     String
  order        Int      // Display order (0-based, ascending)
  text         String   // Instruction text, may contain {ing:<id>} tokens
  timerSeconds Int?     // Optional timer for cook mode
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, order])
}

// Ingredient model stores structured ingredient data for recipes
model Ingredient {
  id        String   @id @default(cuid())
  recipeId  String
  name      String   // The ingredient name (e.g., "chicken breast", "olive oil")
  quantity  String?  // The amount (e.g., "2", "1/2", "500")
  unit      String?  // The unit of measurement (e.g., "cups", "grams", "tablespoons")
  amount    Float?   // Numeric amount parsed from quantity (for servings scaling); null when not parseable, quantity/unit stay as the free-text fallback
  notes     String?  // Additional notes (e.g., "diced", "optional", "for garnish")
  order     Int      // Display order in the recipe
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationship: Each ingredient belongs to one recipe
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

// MealPlan model stores weekly meal plans
model MealPlan {
  id                String   @id @default(cuid())
  date              DateTime // The date for this meal
  dayOfWeek         String   // Monday, Tuesday, etc. (for display)
  lunchRecipeId     String?
  proteinRecipeId   String?
  carbRecipeId      String?
  vegetableRecipeId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationship: Each meal plan references recipes
  lunchRecipe     Recipe? @relation("LunchRecipe", fields: [lunchRecipeId], references: [id], onDelete: Cascade)
  proteinRecipe   Recipe? @relation("ProteinRecipe", fields: [proteinRecipeId], references: [id], onDelete: Cascade)
  carbRecipe      Recipe? @relation("CarbRecipe", fields: [carbRecipeId], references: [id], onDelete: Cascade)
  vegetableRecipe Recipe? @relation("VegetableRecipe", fields: [vegetableRecipeId], references: [id], onDelete: Cascade)

  // Index for efficient querying by date
  @@index([date])
}

// ShoppingList model stores generated shopping lists for a week
model ShoppingList {
  id        String   @id @default(cuid())
  weekStart DateTime // The start date of the week this list is for
  stale     Boolean  @default(false) // True when meal plan changed after list was generated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationship: A shopping list has many items
  items ShoppingListItem[]

  // Ensure only one list per week
  @@unique([weekStart])
}


// ShoppingListItem model stores individual items on a shopping list
model ShoppingListItem {
  id              String   @id @default(cuid())
  shoppingListId  String
  name            String   // The ingredient name (aggregated/normalized)
  quantity        String?  // Combined quantity (e.g., "3" or "2 + 1/2")
  unit            String?  // The unit (when units match during aggregation)
  notes           String?  // Source recipes or additional notes
  checked         Boolean  @default(false) // Whether item has been purchased
  source          String   @default("recipe") // Item source: 'recipe' | 'staple' | 'restock' | 'manual'
  order           Int      // Display order
  masterItemId    String?  // FK → MasterListItem (nullable, set null on delete)
  matchConfidence  String?  // "explicit" | "embedding" | "unmatched" | "pending"
  similarityScore  Float?   // Cosine similarity score from embedding match (for display in review UI)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  shoppingList ShoppingList   @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  masterItem   MasterListItem? @relation(fields: [masterItemId], references: [id], onDelete: SetNull)

  @@index([shoppingListId])
  @@index([masterItemId])
}

// Category model for grouping master list items by store section
model Category {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., "Fresh Produce", "Pantry", "Dairy & Eggs"
  order     Int      // Display order
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationship: A category has many master list items
  items MasterListItem[]
}

// MasterListItem model stores staples and restock items (unified table)
model MasterListItem {
  id             String   @id @default(cuid())
  name           String   // Product name (e.g., "Sainsbury's British Free Range Eggs Large x12")
  type           String   // 'staple' | 'restock'
  categoryId     String
  order          Int      // Display order within category
  normalisedName String?  // Normalised name for shopping list matching e.g. "garlic (granules)", "lemon juice"
  embedding      Float[]  // Pre-computed embedding vector for fast ingredient matching
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  category            Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mappings            IngredientMapping[]
  shoppingListItems   ShoppingListItem[]
  rejectedSuggestions RejectedSuggestion[]
  purchaseHistory     PurchaseHistory[]

  @@index([categoryId])
  @@index([type])
}

// IngredientMapping model stores learned mappings between recipe ingredient names and master list items
model IngredientMapping {
  id             String         @id @default(cuid())
  recipeName     String         // Normalised ingredient name as seen in recipes e.g. "garlic cloves"
  masterItemId   String
  confirmedCount Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  masterItem MasterListItem @relation(fields: [masterItemId], references: [id], onDelete: Cascade)

  @@unique([recipeName, masterItemId])
  @@index([recipeName])
}

// RejectedSuggestion stores user rejections of embedding suggestions
// so the same suggestion is not surfaced again in future syncs
model RejectedSuggestion {
  id             String   @id @default(cuid())
  normalisedName String   // Normalised ingredient name (e.g. "garlic (fresh)")
  masterItemId   String   // The master item that was wrongly suggested
  createdAt      DateTime @default(now())

  masterItem MasterListItem @relation(fields: [masterItemId], references: [id], onDelete: Cascade)

  @@unique([normalisedName, masterItemId])
  @@index([normalisedName])
}

// Caches LLM normalisation results for recipe ingredients to avoid repeat calls
model RecipeIngredientNormalisationCache {
  id        String   @id @default(cuid())
  input     String   @unique // raw ingredient string (lowercased)
  canonical String            // e.g., "spring onion (fresh)"
  base      String            // e.g., "spring onion"
  form      String?           // e.g., "fresh"
  createdAt DateTime @default(now())

  @@map("NormalisationCache")
}

// PurchaseHistory stores receipt line items for restock reminder analysis
model PurchaseHistory {
  id           String   @id @default(cuid())
  rawName      String   // exact product name from receipt e.g. "Sainsbury's Whole Milk 2 Litres"
  purchaseDate DateTime // date of the receipt
  masterItemId String?  // nullable FK - populated later via mapping
  source       String   @default("batch_import") // "batch_import" | "email_agent" | "receipt_upload" etc.
  orderNumber  String?  // Sainsbury's order number; set on rows that come from an uploaded receipt PDF
  lineIndex    Int?     // position of the line on that receipt (with orderNumber: one row per line, so re-uploads never duplicate)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  masterItem MasterListItem? @relation(fields: [masterItemId], references: [id])

  @@unique([orderNumber, lineIndex])
  @@index([purchaseDate])
}

// Receipt: one row per uploaded Sainsbury's receipt PDF. The PDF itself is kept unchanged in private
// Vercel Blob (blobPath) and is the permanent source of truth; PurchaseHistory can be rebuilt from it.
model Receipt {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  purchaseDate  DateTime
  blobPath      String   // private Blob pathname, receipts/<orderNumber>.pdf
  expectedCount Int?     // N from "Groceries (N items)"
  lineCount     Int      // product lines parsed
  unitCount     Int      // product lines parsed, counting quantities (2 x milk = 2)
  countMatches  Boolean  // parsed count equals expectedCount
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ProductMapping: one row per distinct receipt product name -> the "item" it is a version of
// ("JS Whole Cucumber" and "Sainsbury's Whole Cucumber" are both "cucumber"), its aisle, and
// whether it is a cupboard item. Filled once by the cheap model; corrected rows are never overwritten.
model ProductMapping {
  id          String   @id @default(cuid())
  productName String   @unique
  itemName    String
  aisle       String
  cupboard    Boolean  @default(false)
  corrected   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([itemName])
}

// NextWeekTick: a tick Ronen changed on the "Next week" list; kept until that order date has passed
model NextWeekTick {
  id        String   @id @default(cuid())
  orderDate DateTime
  key       String   // "item:<item>" or "raw:<ingredient>"
  ticked    Boolean
  updatedAt DateTime @updatedAt

  @@unique([orderDate, key])
}

// SystemSetting stores key-value application preferences (e.g., weekStartDay)
model SystemSetting {
  key   String @id
  value String
}

// DishType model stores dynamic protein and carb types
model DishType {
  id        String   @id @default(cuid())
  value     String   // e.g., "chicken", "rice" (used in Recipe.proteinType/carbType)
  label     String   // e.g., "Chicken", "Rice" (displayed in UI)
  category  String   // "protein" | "carb"
  order     Int      // Display order within category
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique constraint: no duplicate values within same category
  @@unique([category, value])
  @@index([category])
}

// DayNote stores a free-text note for one calendar day on the meal-plan grid
model DayNote {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date // Calendar day (no time component)
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AgentRun stores one execution of an agent (restock, meal-plan drafting, discovery, ...)
model AgentRun {
  id                  String    @id @default(cuid())
  agent               String    // Agent name, e.g. "restock"
  trigger             String    // manual | batch | schedule | mcp
  input               Json      // What the agent was asked to do
  status              String    @default("running") // running | succeeded | failed
  output              Json?     // Final result when succeeded
  error               String?   // Error message when failed
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  inputTokens         Int       @default(0) // Totals across all model steps
  outputTokens        Int       @default(0)
  cacheReadTokens     Int       @default(0)
  cacheCreationTokens Int       @default(0)

  steps AgentStep[]

  @@index([agent, startedAt])
  @@index([status])
}

// AgentStep stores one step inside an AgentRun: a model turn, a tool call, or a tool result
model AgentStep {
  id           String   @id @default(cuid())
  runId        String
  order        Int      // Position within the run (0-based, ascending)
  kind         String   // model | tool_call | tool_result
  toolName     String?  // Set for tool_call / tool_result
  payload      Json     // model: response content; tool_call: input; tool_result: output
  createdAt    DateTime @default(now())
  inputTokens  Int?     // Token usage, set on model steps
  outputTokens Int?

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, order])
}

// PlanDraft: a drafted (not yet accepted) week of the meal plan. Nothing here counts as the plan until it is
// accepted, which writes it to MealPlan and deletes the draft. `days` holds the whole week as it will become the
// plan: [{ date, dayOfWeek, lunchRecipeId, proteinRecipeId, carbRecipeId, vegetableRecipeId, reason, locked }]
// where `locked` lists the slots Ronen had already filled (the draft never changes those).
model PlanDraft {
  id        String   @id @default(cuid())
  weekStart DateTime @unique @db.Date // first day of the week this draft is for
  days      Json
  summary   String?  // the agent's one-line description of the draft
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

# Database (Neon Postgres)
# In Vercel these are set by the Neon integration (each preview gets its own Neon branch).
# Locally, set both. For a local Postgres they can be the same URL.
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"          # pooled, used at runtime
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"         # direct, used by prisma migrate

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"

# Optional: Change the model if needed (default: gpt-4o-mini for cost efficiency)
OPENAI_MODEL="gpt-4o-mini"

# Perplexity API Configuration (for recipe discovery)
# Get your API key from: https://www.perplexity.ai/settings/api

# Anthropic (Claude) API Configuration — all generative AI
# Get your API key from: https://console.anthropic.com/settings/keys
# The key must have web search enabled (used by Inspire Me recipe discovery).
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# OpenAI API Configuration — EMBEDDINGS ONLY (ingredient matching)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"

# Dev/test ONLY: lets the recipe importer fetch pages from localhost/private addresses (local fixtures).
# Ignored when NODE_ENV is "production" (Vercel production and preview), so never needed there.
# ALLOW_PRIVATE_FETCH=1

# MCP server (/api/mcp) authentication
# A long random secret (e.g. `openssl rand -hex 32`). Required in production and on Vercel previews:
# without it every MCP request is rejected. In Claude.ai, add the connector URL as
# https://<your-app>/api/mcp?token=<this value>
MCP_AUTH_TOKEN=""
